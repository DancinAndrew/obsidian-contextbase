{
  "name": "obsidian-contextbase",
  "version": "0.0.0",
  "private": true,
  "description": "Shared memory for AI agents, kept as notes in your Obsidian vault.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DancinAndrew/obsidian-contextbase.git"
  },
  "bin": {
    "contextbase": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node src/cli.ts serve",
    "test": "node --test \"test/**/*.test.ts\"",
    "eval": "node scripts/eval.ts",
    "bench": "node scripts/bench.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
